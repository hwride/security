{
  "name": "security-cors",
  "version": "1.0.0",
  "type": "module",
  "description": "Runs some CORS tests and captures script and network request details using Puppeteer and a transparent proxy.",
  "scripts": {
    "dev": "node src/run-cors-tests.ts",
